# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://jobagent:jobagent@127.0.0.1:5432/jobagent
TEST_DATABASE_URL=postgres://jobagent:jobagent@127.0.0.1:5432/jobagent_test

# Where PDFs and evidence files are written
DATA_DIR=./data

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Used from M1 to encrypt the Claude API key.
APP_ENCRYPTION_KEY=
