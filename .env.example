# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://jobagent:jobagent@127.0.0.1:5432/jobagent
TEST_DATABASE_URL=postgres://jobagent:jobagent@127.0.0.1:5432/jobagent_test

# Where PDFs and evidence files are written
DATA_DIR=./data

# 32-byte key, base64. Generate with: openssl rand -base64 32
# Encrypts the Claude API key, if you use one.
APP_ENCRYPTION_KEY=

# Optional: read Indeed and LinkedIn alerts from Gmail. A Google OAuth client of type "Web application",
# with http://127.0.0.1:3000/api/gmail/callback as its redirect URI. See docs/SOURCES.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: where the Claude Code CLI lives, if it isn't found on PATH.
# CLAUDE_CLI_PATH=
